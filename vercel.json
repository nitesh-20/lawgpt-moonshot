{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd frontend-app && npm install && npm run build",
  "outputDirectory": "frontend-app/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
