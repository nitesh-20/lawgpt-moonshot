# ---------------------------------------------------------
# LawGPT AI OS - Backend Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ---------------------------------------------------------

# General Application Settings
APP_NAME="LawGPT AI OS Backend"
APP_VERSION="0.1.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development" # development, testing, staging, production

# Logging Configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="DEBUG"

# Storage Settings
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes
UPLOAD_FOLDER="uploads"

# Firebase Credentials
FIREBASE_PROJECT_ID="your-firebase-project-id"
GOOGLE_APPLICATION_CREDENTIALS="serviceAccountKey.json"

# Sarvam AI API Configurations
SARVAM_API_KEY="your-sarvam-api-key"
SARVAM_BASE_URL="https://api.sarvam.ai"

# Google Gemini API (Optional for supplemental processing)
GEMINI_API_KEY="your-gemini-api-key"

# Google Cloud Storage (GCS) Configuration
GCS_BUCKET="your-gcs-bucket-name"
